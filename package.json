{
  "name": "api-clube",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "generate-docs": "node generate-docs.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "build": "esbuild index.js --bundle --platform=node --outfile=dist/bundle.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-oas-generator": "^1.0.48",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "yamljs": "^0.3.0",
    "esbuild": "^0.25.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "src/server.js",
      "!src/config/database.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
